{
    "name": "axelate-root",
    "version": "0.1.5",
    "private": true,
    "description": "Root proxy for Axelate",
    "scripts": {
        "dev": "powershell -ExecutionPolicy Bypass -File .\\.github\\scripts\\dev.ps1",
        "build": "cd src && npm run build",
        "clean": "powershell -ExecutionPolicy Bypass -File .\\.github\\scripts\\clear.ps1",
        "clean:frontend": "cd src && npm run clean",
        "clean:deep": "powershell -ExecutionPolicy Bypass -File .\\.github\\scripts\\clear.ps1 --deep",
        "preview": "cd src && npm run preview",
        "tauri:dev": "npx --prefix src tauri dev",
        "tauri:build": "npx --prefix src tauri build",
        "release": "cd src && npm run release",
        "release:ps": "powershell -ExecutionPolicy Bypass -File .\\.github\\scripts\\release.ps1",
        "run": "start .\\src-tauri\\target\\x86_64-pc-windows-msvc\\release\\\"Axelate.exe\"",
        "lint": "cd src && npm run lint",
        "format": "cd src && npm run format",
        "format:check": "cd src && npm run format:check",
        "test": "cd src && npm run test",
        "test:watch": "cd src && npm run test:watch",
        "typecheck": "cd src && npm run typecheck",
        "verify-all": "powershell -ExecutionPolicy Bypass -File .\\.github\\scripts\\verify-all.ps1",
        "install-deps": "cd src && npm install",
        "update": "powershell -ExecutionPolicy Bypass -File .\\.github\\scripts\\update.ps1",
        "prepare": "husky",
        "bump": "node src/scripts/bump-version.js",
        "check-size": "node src/scripts/check-size.js"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.3.1",
        "@commitlint/config-conventional": "^20.3.1",
        "@types/node": "^25.3.1",
        "eslint": "^10.0.2",
        "globals": "^17.3.0",
        "husky": "^9.1.7"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
