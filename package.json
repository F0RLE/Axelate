{
    "name": "axelate-root",
    "version": "0.1.4",
    "private": true,
    "description": "Root proxy for Axelate",
    "scripts": {
        "dev": "cd src && npm run dev",
        "build": "cd src && npm run build",
        "clean": "cd src && npm run clean",
        "preview": "cd src && npm run preview",
        "tauri:dev": "cd src && npm run tauri:dev",
        "tauri:build": "cd src && npm run tauri:build",
        "release": "cd src && npm run release",
        "run": "start .\\src-tauri\\target\\x86_64-pc-windows-msvc\\release\\\"Axelate.exe\"",
        "lint": "cd src && npm run lint",
        "format": "cd src && npm run format",
        "format:check": "cd src && npm run format:check",
        "test": "cd src && npm run test",
        "test:watch": "cd src && npm run test:watch",
        "typecheck": "cd src && tsc --noEmit",
        "install-deps": "cd src && npm install",
        "update": "powershell -ExecutionPolicy Bypass -File .\\.github\\scripts\\update.ps1",
        "prepare": "husky .github/.husky",
        "bump": "node src/scripts/bump-version.js"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.3.1",
        "@commitlint/config-conventional": "^20.3.1",
        "concurrently": "^8.2.2",
        "husky": "^9.1.7"
    }
}
