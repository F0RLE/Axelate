{
    "name": "axelate-root",
    "version": "0.1.5",
    "private": true,
    "description": "Root proxy for Axelate",
    "scripts": {
        "dev": "node scripts/workflow.mjs dev",
        "dev:app": "node scripts/workflow.mjs dev:app",
        "dev:webview": "node scripts/workflow.mjs dev:webview",
        "dev:inspect": "node scripts/workflow.mjs dev:inspect",
        "dev:release-like": "node scripts/workflow.mjs dev:release-like",
        "build": "node scripts/workflow.mjs build",
        "clean": "node scripts/workflow.mjs clean",
        "clean:frontend": "npm --prefix src run clean",
        "clean:deep": "node scripts/workflow.mjs clean --deep",
        "preview": "node scripts/workflow.mjs preview",
        "tauri:dev": "node scripts/workflow.mjs dev:webview",
        "tauri:build": "node scripts/workflow.mjs tauri:build",
        "release": "node scripts/workflow.mjs release",
        "release:ps": "pwsh -ExecutionPolicy Bypass -File .\\.github\\scripts\\release.ps1",
        "run": "node scripts/workflow.mjs run",
        "lint": "node scripts/workflow.mjs lint",
        "format": "node scripts/workflow.mjs format",
        "format:check": "node scripts/workflow.mjs format:check",
        "test": "node scripts/workflow.mjs test",
        "test:coverage": "node scripts/workflow.mjs test:coverage",
        "test:watch": "node scripts/workflow.mjs test:watch",
        "typecheck": "node scripts/workflow.mjs typecheck",
        "verify": "node scripts/workflow.mjs verify",
        "verify-all": "node scripts/workflow.mjs verify",
        "install-deps": "node scripts/workflow.mjs install-deps",
        "update": "node scripts/workflow.mjs update",
        "update:ps": "pwsh -ExecutionPolicy Bypass -File .\\.github\\scripts\\update.ps1",
        "prepare": "node scripts/workflow.mjs prepare",
        "bump": "node src/scripts/bump-version.js",
        "check-size": "node scripts/workflow.mjs check-size"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
