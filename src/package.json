{
    "name": "axelate-frontend",
    "version": "0.1.5",
    "description": "Axelate Frontend",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "clean": "rmdir /s /q dist 2>nul & echo Cleaned",
        "tauri:dev": "taskkill /F /IM \"Axelate.exe\" /T >nul 2>nul & cd .. && tauri dev --target x86_64-pc-windows-msvc",
        "tauri:build": "taskkill /F /IM \"Axelate.exe\" /T >nul 2>nul & cd .. && tauri build",
        "release": "taskkill /F /IM \"Axelate.exe\" /T >nul 2>nul & npm run format && npm run typecheck && npm run lint && npm run test && npm run build && cd .. && tauri build --release && explorer ..\\src-tauri\\target\\release\\bundle",
        "check-size": "node scripts/check-size.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@tauri-apps/api": "^2.1.0",
        "@tauri-apps/cli": "^2.1.0",
        "@types/node": "^25.2.0",
        "@vitest/ui": "^4.0.18",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jsdom": "^27.4.0",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.19.1",
        "vite": "^7.3.1",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "dompurify": "^3.3.1",
        "highlight.js": "^11.11.1",
        "katex": "^0.16.28",
        "marked": "^17.0.1",
        "marked-alert": "^2.0.1",
        "marked-footnote": "^1.2.4",
        "marked-highlight": "^2.2.1",
        "marked-katex-extension": "^5.1.2"
    }
}
