# Axelate - .editorconfig

root = true

# Global defaults
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Configuration files (JSON, TOML) - TOML uses 2 spaces
[*.toml]
indent_size = 2

[*.json]
indent_size = 4

# Core stack (TS, Rust, CSS, HTML)
[*.{ts,rs,css,html,js}]
indent_size = 4

# Documentation
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Scripts
[*.ps1]
charset = utf-8-bom
indent_size = 4
