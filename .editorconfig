# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

# All files
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JSON, YAML, TOML, Markdown - often use 2 spaces
[*.{yml,yaml,toml,json}]
indent_size = 2

# JavaScript, TypeScript, CSS - maintain 4 spaces (Axelate style)
[*.{js,jsx,ts,tsx,css,scss,html}]
indent_size = 4

# Rust
[*.rs]
indent_style = space
indent_size = 4

# Markdown (allow trailing spaces for line breaks)
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# PowerShell
[*.ps1]
indent_size = 4
charset = utf-8-bom

# Batch scripts
[*.{cmd,bat}]
end_of_line = crlf
indent_style = tab
