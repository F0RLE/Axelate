**/target/
Cargo.lock
src-tauri/gen/
src-tauri/check_output.txt
src-tauri/resources/tools/
**/*.rs.bk

# ─────────────────────────────────────────────────────────────────────
# Node.js / Frontend
# ─────────────────────────────────────────────────────────────────────
node_modules/
**/dist/
.vite/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Linting
coverage/
.vitest/
.eslintcache
.stylelintcache
.prettiercache
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────────────
