# IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.vs/
*.swp
*.swo

# Environment & Logs
.env
.env.*
!**/.env.example
.envrc
.direnv/
*.log
.eslintcache
.cache/
.history/

# System
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db

# Application
AxelateData/
data/
.playwright-cli/
output/
