{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Axelate",
    "mainBinaryName": "Axelate",
    "version": "0.1.5",
    "identifier": "com.axelate",
    "build": {
        "beforeDevCommand": "npm run dev --prefix src",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build --prefix src",
        "frontendDist": "../src/dist"
    },
    "plugins": {
        "dev": {
            "watch": [
                "src-tauri/resources/**/*",
                "src-tauri/src/**/*.rs",
                "src-tauri/Cargo.toml"
            ]
        }
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "title": "Axelate",
                "width": 1520,
                "height": 980,
                "minWidth": 1180,
                "minHeight": 720,
                "center": true,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "transparent": false,
                "visible": false,
                "backgroundColor": "#111015"
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost https://openrouter.ai https://*.openrouter.ai; frame-src 'self' asset: http://asset.localhost; base-uri 'self'",
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/AxelateData/System/Modules/**",
                    "$HOME/.config/AxelateData/System/Modules/**",
                    "$HOME/Library/Application Support/AxelateData/System/Modules/**"
                ]
            },
            "capabilities": [
                "default"
            ]
        }
    },
    "bundle": {
        "publisher": "Axelate Team",
        "copyright": "Copyright © 2026 Axelate",
        "active": true,
        "windows": {
            "webviewInstallMode": {
                "type": "downloadBootstrapper",
                "silent": true
            },
            "nsis": {
                "minimumWebview2Version": "110.0.1531.0"
            }
        },
        "targets": [
            "msi",
            "nsis"
        ],
        "resources": [
            "resources/config",
            "resources/locales",
            "resources/api_providers.json"
        ],
        "icon": [
            "icons/icon.ico",
            "icons/icon.png"
        ]
    }
}
