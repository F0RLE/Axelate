{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Axelate",
    "mainBinaryName": "Axelate",
    "version": "0.1.4",
    "identifier": "com.axelate.platform",
    "build": {
        "beforeDevCommand": "npm run dev --prefix src",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build --prefix src",
        "frontendDist": "../src/dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Axelate",
                "width": 1400,
                "height": 900,
                "minWidth": 1000,
                "minHeight": 600,
                "center": true,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "transparent": false,
                "visible": true,
                "backgroundColor": "#111015"
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost https:; base-uri 'self'",
            "capabilities": [
                "default"
            ]
        }
    },
    "bundle": {
        "publisher": "Axelate Team",
        "copyright": "Copyright © 2026 Axelate",
        "active": true,
        "targets": [
            "msi",
            "nsis"
        ],
        "resources": [
            "resources/config/**/*",
            "resources/api_providers.json"
        ],
        "icon": [
            "icons/icon.ico",
            "icons/icon.png"
        ]
    }
}
